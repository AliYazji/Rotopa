{
  "name": "rotopa-etl",
  "private": true,
  "type": "module",
  "description": "Migrate miles2023 (SQL Server) into a Rotopa organization on Postgres/Supabase",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "etl": "tsx src/run.ts",
    "etl:currencies": "tsx src/run.ts currencies",
    "etl:accounts": "tsx src/run.ts categories accounts categorize-accounts",
    "etl:rates": "tsx src/run.ts rates",
    "etl:dealers": "tsx src/run.ts dealers",
    "etl:inventory": "tsx src/run.ts inventory",
    "etl:opening-stock": "tsx src/run.ts opening-stock",
    "etl:opening": "tsx src/run.ts opening-balances",
    "etl:categorize-accounts": "tsx src/run.ts categorize-accounts",
    "verify": "tsx src/verify.ts",
    "preflight": "tsx src/preflight.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "mssql": "^11.0.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.11",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
